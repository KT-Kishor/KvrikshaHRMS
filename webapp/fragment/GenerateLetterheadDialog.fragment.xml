<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:richeditor="sap.ui.richtexteditor"
>
    <Dialog
        id="GPD_id_Dialog"
        contentWidth="100%"
        draggable="true"
        resizable="true"
        verticalScrolling="true"
    >
        <customHeader>
            <Bar>
                <contentLeft>
                    <Title
                        text="{i18n>GeneratePDF}"
                        level="H2"
                    />
                </contentLeft>

                <contentRight>
                    <Button
                        id="GPD_id_BtnClose"
                        icon="sap-icon://decline"
                        type="Transparent"
                        tooltip="{i18n>close}"
                        press=".GP_onCloseDialog"
                    />
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <l:Grid
                defaultSpan="XL6 L6 M6 S12"
                hSpacing="1"
                vSpacing="1"
                class="sapUiSmallMargin"
            >
                <VBox>
                    <Label text="{i18n>referenceNumber}" />

                    <Input
                        id="GPD_id_ReferenceNumber"
                        width="100%"
                        placeholder="{i18n>enterReferenceNumber}"
                    />
                </VBox>

                <VBox>
                    <Label
                        text="{i18n>date}"
                        required="true"
                    />

                    <DatePicker
                        id="GPD_id_Date"
                    
                        required="true"
                        displayFormat="dd/MM/yyyy"
                        valueFormat="dd/MM/yyyy"
                        placeholder="{i18n>selectDate}"
                        valueStateText="{i18n>dateMandatory}"
                        change=".GP_onDateChange"
                    />
                </VBox>

                <!-- Subject -->
                <VBox>
                    <Label
                        text="{i18n>subject}"
                      
                    />

                    <Input
                        id="GPD_id_Subject"
                       
                        placeholder="{i18n>enterSubject}"
                        change=".GP_onMandatoryChange"
                        valueStateText="{i18n>subjectMandatory}"
                        liveChange=".GP_onSubjectLiveChange"
                    />
                </VBox>

                <!-- Include Signature -->
                <VBox justifyContent="End">
                    <Label text="{i18n>signature}" />

                    <CheckBox
                        id="GPD_id_IncludeSignature"
                        text="{i18n>includeSignature}"
                        selected="true"
                    />
                </VBox>

                <VBox>
                    <layoutData>
                        <l:GridData span="XL12 L12 M12 S12" />
                    </layoutData>

                    <Label
                        text="{i18n>content}"
                        required="true"
                    />

                    <richeditor:RichTextEditor
                        id="GPD_id_Content"
                        width="100%"
                        height="18rem"
                        editorType="TinyMCE6"
                        value=""
                        showGroupClipboard="true"
                        showGroupFont="true"
                        showGroupInsert="true"
                        showGroupLink="true"
                        showGroupStructure="true"
                        showGroupTextAlign="true"
                        showGroupUndo="true"
                        editable="true"
                        change=".GP_onContentChange"
                    />
                </VBox>
            </l:Grid>
        </content>

        <buttons>
            <Button
                id="GPD_id_BtnGeneratePDF"
                text="{i18n>GeneratePDF}"
                icon="sap-icon://pdf-attachment"
                type="Transparent"
                press=".GP_onGeneratePDF"
            />

            <Button
                id="GPD_id_BtnSaveGeneratePDF"
                text="{i18n>saveGeneratePdf}"
                icon="sap-icon://save"
                type="Transparent"
                press=".GP_onSaveGeneratePDF"
                 visible="false"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>