<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <Dialog
    title="Create Question"
    contentWidth="50%"
    contentHeight="70%">

    <VBox class="sapUiMediumMargin">

        <!-- Form Section -->
        <f:SimpleForm
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="3"
            labelSpanL="3"
            labelSpanM="3"
            labelSpanS="12"
            columnsXL="1"
            columnsL="1"
            columnsM="1">

            <f:content>

                <Label text="{i18n>testid}" required="true"/>
                <Input value="{questionModel>/test_id}" liveChange="ontestID" valueStateText="{i18n>entertestid}" id="testid"/>

                <Label text="{i18n>questiontext}" required="true"/>
                <Input value="{questionModel>/question_text}" valueStateText="{i18n>SelectQuestion}" id="idQuestiontext" liveChange="onQuestionchnage"/>

                <Label text="{i18n>mark}" required="true"/>
                <Input value="{questionModel>/marks}" valueStateText="{i18n>entermark}" id="idmard" type="Number"  liveChange="onMarkchange"/>

                <Label text="{i18n>type}" required="true"/>
                <Input value="{questionModel>/type}" valueStateText="{i18n>entertype}" id="idtype"  liveChange="onTypechange"/>

                <Label text="{i18n>orderno}" required="true"/>
                <Input value="{questionModel>/order_no}" valueStateText="{i18n>enterOrderNo}" id="idOrderno" type="Number" liveChange="onOrderNo"/>

            </f:content>

        </f:SimpleForm>

        <!-- Options Section -->
        <Panel
            headerText="Options"
            class="sapUiMediumMarginTop">

            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Options"/>
                    <ToolbarSpacer/>
                    <Button
                        text="Add Option"
                        type="Transparent"
                        press="onAddOption" class="whiteLabel"/>
                </OverflowToolbar>
            </headerToolbar>

            <Table
                width="100%"
                items="{questionModel>/options}">

                <columns>

                    <Column  demandPopin="true">
                        <Text text="Option Text"/>
                    </Column>

                    <Column  demandPopin="true">
                        <Text text="Is Correct"/>
                    </Column>

                    <Column >
                        <Text text="Order No"/>
                    </Column>

                    <Column >
                        <Text text="Action"/>
                    </Column>

                </columns>

                <items>
                    <ColumnListItem>

                        <cells>

                          
    <Input
        id="idBulkOptionInput"
        placeholder="Paste multiple options separated by new lines"/>


                            <Select
                                selectedKey="{questionModel>is_correct}">

                                <core:Item
                                    key="true"
                                    text="True"/>

                                <core:Item
                                    key="false"
                                    text="False"/>

                            </Select>

                            <Input
                                value="{questionModel>order_no}"
                                type="Number" liveChange="onOrderNo"/>

                            <Button
                                icon="sap-icon://decline"
                                type="Transparent"
                                press="onDeleteOption"/>

                        </cells>

                    </ColumnListItem>
                </items>

            </Table>

        </Panel>

    </VBox>

   <footer>
    <Toolbar>
        <HBox
            width="100%"
            justifyContent="End"
            alignItems="Center">
        <Button
            text="Save"
            type="Transparent"
            press="onSaveQuestion"/>
   
        <Button
            text="Close"
            type="Transparent"
            press="onCloseQuestion"/>
  
</HBox>
    </Toolbar>
</footer>
</Dialog>

</core:FragmentDefinition>