<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    xmlns:f="sap.f"
    xmlns:cards="sap.f.cards"
    xmlns:layout="sap.ui.layout"
>
   <Dialog
    title="{i18n>candidateAssessmentReportTitle}"
    contentWidth="80%"
    draggable="true"
    resizable="true"
    verticalScrolling="true"
    horizontalScrolling="false">
        <customHeader>
            <Bar>
                <contentLeft>
                    <Title text="{i18n>candidateAssessmentReportTitle}" level="H3" />
                </contentLeft>
            </Bar>
        </customHeader>
        <content>
            <VBox class="sapUiSmallMarginBeginEnd sapUiSmallMarginTopBottom" width="100%">

                <!-- ===== PROFILE HEADER ===== -->
            
                    <!-- <Avatar
                        src="{= ${studentModel>/photo} ? 'data:image/jpeg;base64,' + ${studentModel>/photo} : '' }"
