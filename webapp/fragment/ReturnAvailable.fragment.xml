<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="RA_id_ValueHelpDialog"
        title="{i18n>Availbility}"
        contentWidth="70%"
    >
        <content>
     <Table
    id="id_RS_Table"
    width="100%"
    growing="true"
    growingScrollToLoad="true"
    alternateRowColors="true"
    items="{ReturnModel>/}">

    <columns>

        <Column >
            <Text text="{i18n>employee}" />
        </Column>

        <Column>
            <Text text="{i18n>Date}" />
        </Column>

        <Column >
            <Text text="{i18n>Time}" />
        </Column>

        <Column >
            <Text text="{i18n>Location}" />
        </Column>

        <Column >
            <Text text="Status" />
        </Column>

    </columns>

    <items>

        <ColumnListItem >

            <cells>

                <!-- Employee -->
                <ObjectIdentifier
                    title="{ReturnModel>EmployeeName}"
                    text="{ReturnModel>EmployeeID}" />

                <!-- Date -->
            <Text
    wrapping="false"
    text="{
        parts:[
            {path:'ReturnModel>StartDate'},
            {path:'ReturnModel>EndDate'}
        ],
        formatter: '.Formatter.formatDateRange'
    }"/>

                <!-- Time -->
                <VBox>
                    <Text
                        text="{= '🕒 ' + ${ReturnModel>StartTime} + ' - ' + ${ReturnModel>EndTime} }"
                        wrapping="false" />
                </VBox>

                <!-- Location -->
                <HBox alignItems="Center">
                    <Text text="📍" />
                    <Text
                        text="{ReturnModel>Location}"
                        class="sapUiTinyMarginBegin" />
                </HBox>

                <!-- Status -->
                <ObjectStatus
                    text="Available"
                    state="Success" />

            </cells>

        </ColumnListItem>

    </items>

</Table>
        </content>
        <beginButton>
            <Button
                text="{i18n>close}"
                type="Transparent"
                press="FDP_onVHDClose"
            />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>