<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">

    <Dialog
        id="TimesheetdownloadDialog"
        title="Download Timesheet"
        contentWidth="26rem">

        <content>
            <f:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="0"
                emptySpanL="0"
                emptySpanM="0"
                emptySpanS="0">

                <Label text="{i18n>assigntasktitle}" required="true"/>
                <ComboBox
    id="Taskid"
    items="{TimesheetModel>/}"
        selectedKey="{DownloadTimesheetModel>/SelectedTask}"
    showClearIcon="true">

    <core:ListItem
        key="{TimesheetModel>TaskID}"
        text="{TimesheetModel>TaskName}"
        additionalText="{TimesheetModel>Date}" />

</ComboBox>

                <Label text="Month" required="true"/>
                <ComboBox id="monthSelec1" showClearIcon="true" width="100%" items="{DownloadTimesheetModel>/MonthList}" value="{DownloadTimesheetModel>/SelectedMonth}">
                    <core:Item key="{DownloadTimesheetModel>MonthKey}" text="{DownloadTimesheetModel>MonthLabel}"/>
                </ComboBox>

                <Label text="Download Format" required="true"/>
                <RadioButtonGroup
                    id="formatRadioGroup1"
                    columns="2"
                    selectedIndex="{DownloadTimesheetModel>/SelectedFormat}"
                    select="onFormatSelect">
                    <RadioButton text="PDF" selected="true"/>
                    <RadioButton text="Excel"/>
                </RadioButtonGroup>

            </f:SimpleForm>
        </content>

       <footer>
    <Toolbar>
        <HBox
            width="100%"
            justifyContent="End"
            alignItems="Center">
            <Button
                text="Download"
                type="Transparent"
                press="onConfirmDownload"/>
     
        
            <Button
                text="Cancel"
                press="onCancelDownload"/>
      </HBox>
    </Toolbar>
</footer>

    </Dialog>
</core:FragmentDefinition>