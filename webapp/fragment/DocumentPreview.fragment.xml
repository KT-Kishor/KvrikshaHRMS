<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="previewDialog"
        title="Document Preview"
        stretch="true"
        draggable="true"
        resizable="true"
        contentWidth="90%"
        contentHeight="90%">

        <content>
            <Image
                id="previewImage"
                visible="false"
                width="100%"
                densityAware="false"
                class="imagePreviewFit"/>

            <core:HTML
                id="previewHtml"
                visible="false"/>
        </content>

     <footer>
    <Toolbar>
        <HBox
            width="100%"
            justifyContent="End"
            alignItems="Center">
            <Button
                text="Download"
                type="Transparent"
                press=".onDownloadPreview"/>
       
            <Button
                text="Close"
                press=".onClosePreview"/>
      </HBox>
    </Toolbar>
</footer>

    </Dialog>

</core:FragmentDefinition>