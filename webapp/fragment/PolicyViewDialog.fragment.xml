<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:suite="sap.suite.ui.commons"
>
    <Dialog
        id="FPL_id_PolicyViewDialog"
        title="{i18n>policyDetails}"
        contentWidth="92%"
        contentHeight="95%"
        stretch="{device>/system/phone}"
        draggable="true"
        resizable="true"
        horizontalScrolling="false"
        verticalScrolling="false"
        class="policyResponsiveDialog noDialogScroll sapUiNoContentPadding"
    >
        <!-- ================= HEADER ================= -->
        <customHeader>
            <OverflowToolbar
                id="PL_id_ViewDialogHeaderBar"
                class="policyHeaderToolbar"
            >
                <Title
                    id="PL_id_ViewDialogTitle"
                    text="{i18n>policyDetails}"
                    level="H4"
                    wrapping="false"
                />
                <ToolbarSpacer />
                <Button
                    id="PL_id_ViewDialogCloseBtn"
                    icon="sap-icon://decline"
                    tooltip="{i18n>closeDialog}"
                    type="Transparent"
                    press="PL_onCloseViewDialog"
                />
            </OverflowToolbar>
        </customHeader>

        <!-- ================= CONTENT ================= -->
        <content>
            <l:ResponsiveSplitter
                id="PL_id_MainVBox"
                width="100%"
                height="100%"
                defaultPane="PL_id_DefaultPane"
            >
                <l:PaneContainer>

                    <!-- ================= LEFT PANE: DETAILS ================= -->
                    <l:SplitPane
                        id="PL_id_DefaultPane"
                        requiredParentWidth="1"
                        class="sapUiTinyMarginBegin"
                    >
                        <l:layoutData>
                            <l:SplitterLayoutData
                                size="22rem"
                                minSize="200"
                                resizable="true"
                            />
                        </l:layoutData>

                  <VBox
    id="PL_id_TopSectionVBox"
    width="100%"
    height="100%"
    renderType="Bare"
>
                            <VBox
                                width="100%"
                                class="sapUiResponsiveContentPadding "
                            >
                                <!-- Panel heading -->
                                <!-- <Title
                                    text="{i18n>policyDetails}"
                                    level="H5"
                                    titleStyle="H5"
                                    wrapping="false"
                                    class="sapUiSmallMarginBottom sapUiMediumMarginTop"
                                /> -->

                                <HBox width="100%" class="sapUiTinyMarginBottom">
                                    <layoutData>
                                        <FlexItemData growFactor="1" />
                                    </layoutData>
                                </HBox>

                                <!-- ================= TITLE ================= -->
                                <VBox
                                    id="PL_id_TitleVBox"
                                    width="100%"
                                    class="sapUiSmallMarginBottom"
                                >
                                    <Label
                                        id="PL_id_TitleLabel"
                                        text="{i18n>title}:"
                                        design="Bold"
                                        required="{= ${VisibleModel>/EditBtn} !== true }"
                                    />
                                    <Text
                                        id="PL_id_ViewTitleText"
                                        text="{policyViewModel>/title}"
                                        visible="{= ${VisibleModel>/EditBtn} === true}"
                                        wrapping="false"
                                        maxLines="1"
                                        width="100%"
                                    />
                                    <TextArea
                                        rows="2"
                                        id="PL_id_ViewTitle"
                                        width="100%"
                                        value="{policyViewModel>/title}"
                                        visible="{= ${VisibleModel>/EditBtn} !== true}"
                                        liveChange="PL_onLiveChangeValidation"
                                        maxLength="50"
                                        placeholder="{i18n>enterPolicyTitle}"
                                    />
                                </VBox>

                                <!-- ================= DEPARTMENT ================= -->
                                <VBox
                                    id="PL_id_DepartmentVBox"
                                    width="100%"
                                    class="sapUiSmallMarginBottom"
                                >
                                    <Label
                                        id="PL_id_DepartmentLabel"
                                        text="{i18n>department}:"
                                        design="Bold"
                                        required="{= ${VisibleModel>/EditBtn} !== true }"
                                    />
                                    <Text
                                        id="PL_id_DepartmentText"
                                        text="{policyViewModel>/department}"
                                        visible="{= ${VisibleModel>/EditBtn} === true}"
                                        wrapping="false"
                                        width="100%"
                                    />
                                    <ComboBox
                                        id="PL_id_ViewDepartment"
                                        width="100%"
                                        selectedKey="{policyViewModel>/department}"
                                        visible="{= ${VisibleModel>/EditBtn} !== true}"
                                        selectionChange="PL_onDepartmentChange"
                                        items="{path:'DepartmentModel>/'}"
                                        placeholder="{i18n>selectDepartment}"
                                    >
                                        <core:Item
                                            key="{DepartmentModel>department}"
                                            text="{DepartmentModel>department}"
                                        />
                                    </ComboBox>
                                </VBox>

                                <!-- ================= ROLE ================= -->
                                <VBox
                                    id="PL_id_RoleVBox"
                                    width="100%"
                                    class="sapUiSmallMarginBottom"
                                >
                                    <Label
                                        id="PL_id_RoleLabel"
                                        text="{i18n>role}:"
                                        design="Bold"
                                        required="{= ${VisibleModel>/EditBtn} !== true }"
                                    />
                                    <Text
                                        id="PL_id_RoleText"
                                        text="{policyViewModel>/role}"
                                        visible="{= ${VisibleModel>/EditBtn} === true}"
                                        wrapping="false"
                                        maxLines="1"
                                        width="100%"
                                        tooltip="{= typeof ${policyViewModel>/role} === 'string' ? ${policyViewModel>/role} : ${policyViewModel>/role}.join(', ') }"
                                    />
                                    <MultiComboBox
                                        id="PL_id_ViewRole"
                                        width="100%"
                                        selectedKeys="{policyViewModel>/role}"
                                        visible="{= ${VisibleModel>/EditBtn} !== true}"
                                        selectionChange="PL_onSelectionChangeValidation"
                                        items="{path:'FilteredRoleModel>/'}"
                                        placeholder="{i18n>selectRole}"
                                    >
                                        <core:Item
                                            key="{FilteredRoleModel>designationName}"
                                            text="{FilteredRoleModel>designationName}"
                                        />
                                    </MultiComboBox>
                                </VBox>

                                <!-- ================= START DATE ================= -->
                               <VBox
    id="PL_id_StartDateVBox"
    width="100%"
    class="sapUiSmallMarginBottom">

    <Label
        id="PL_id_StartDateLabel"
        text="{i18n>StartedDate}:"
        design="Bold" />
        <Text id="PL_id_StartDateText" visible="{= ${VisibleModel>/EditBtn} === true}"  text="{policyViewModel>/Start_Date}" wrapping="false" width="100%" />


    <DatePicker
     visible="{= ${VisibleModel>/EditBtn} !== true}"
        id="PL_id_StartDateText1"
        value="{policyViewModel>/Start_Date}"
        valueFormat="yyyy-MM-dd"
        displayFormat="dd/MM/yyyy"
             />
</VBox>

                                <!-- ================= DESCRIPTION ================= -->
                                <VBox
                                    id="PL_id_DescriptionVBox"
                                    width="100%"
                                    class="sapUiSmallMarginBottom"
                                >
                                    <Label
                                        id="PL_id_DescriptionLabel"
                                        text="{i18n>description}:"
                                        design="Bold"
                                        required="{= ${VisibleModel>/EditBtn} !== true }"
                                    />
                                    <Text
                                        id="PL_id_DescriptionText"
                                        text="{policyViewModel>/description}"
                                        visible="{= ${VisibleModel>/EditBtn} === true}"
                                        wrapping="true"
                                        width="100%"
                                    />
                                    <TextArea
                                        id="PL_id_ViewDescription"
                                        width="100%"
                                        rows="3"
                                        growing="true"
                                        growingMaxLines="6"
                                        maxLength="100"
                                        value="{policyViewModel>/description}"
                                        liveChange="PL_onLiveChangeValidation"
                                        visible="{= ${VisibleModel>/EditBtn} !== true}"
                                        placeholder="{i18n>enterDescription}"
                                       
                                    />
                                </VBox>

                                <!-- ================= EDIT / SAVE ================= -->
                                <!-- <Button
                            
                                    id="PL_id_EditSaveBtn"
                                    text="{= ${VisibleModel>/EditBtn} === true ? ${i18n>edit} : ${i18n>save} }"
                                    tooltip="{= ${VisibleModel>/EditBtn} === true ? ${i18n>editPolicyDetails} : ${i18n>savePolicyDetails} }"
                                    press="PL_onPressEditAndSave"
                                    visible="{= ${visibilityModel>/showAdminControls} === true }"
                                   
                                    width="100%"
                                    class="sapUiSmallMarginTop sapUiSmallMarginBottom"
                                /> -->

                            </VBox>
                        </VBox>
                    </l:SplitPane>
                    <!-- ================= RIGHT PANE: PDF VIEWER ================= -->
                    <!-- ================= RIGHT PANE: PDF VIEWER ================= -->
<l:SplitPane requiredParentWidth="600">
    <l:layoutData>
        <l:SplitterLayoutData
            size="auto"
            minSize="300"
            resizable="true"
        />
    </l:layoutData>
    <VBox
        width="100%"
        height="100%"
        fitContainer="true"
        renderType="Bare"
    >
        <core:HTML
            id="pdfFrame"
            preferDOM="true"
        />
    </VBox>
</l:SplitPane>

                </l:PaneContainer>
            </l:ResponsiveSplitter>
        </content>

        <!-- ================= FOOTER ================= -->
        <footer>
            <OverflowToolbar
                id="PL_id_FooterBar"
                class="policyFooterToolbar"
            >
                <CheckBox
                    id="PL_id_AcknowledgeCheckBox"
                    text="{i18n>acknowledgePolicy}"
                    tooltip="{i18n>confirmAcknowledgement}"
                    selected="{policyViewModel>/acknowledged}"
                    select="onAcknowledgeCheck"
                    visible="{= ${policyViewModel>/alreadyAcknowledged} === false }"
                />
                <ToolbarSpacer />
                  <Button
            id="PL_id_EditSaveBtn"
            text="{= ${VisibleModel>/EditBtn} === true ? ${i18n>edit} : ${i18n>save} }"
            tooltip="{= ${VisibleModel>/EditBtn} === true ? ${i18n>editPolicyDetails} : ${i18n>savePolicyDetails} }"
            press="PL_onPressEditAndSave"
            visible="{= ${visibilityModel>/showAdminControls} === true }"
        />
                <Button
                    id="PL_id_AcknowledgeBtn"
                    text="{i18n>acknowledge}"
                    tooltip="{i18n>acknowledgeTooltip}"
                    enabled="{policyViewModel>/acknowledged}"
                    press="onPressAcknowledge"
                    visible="{= ${policyViewModel>/alreadyAcknowledged} === false }"
                    type="Emphasized"
                />
                <ToolbarSpacer width="0.5rem" />
            </OverflowToolbar>
        </footer>
    </Dialog>
</core:FragmentDefinition>