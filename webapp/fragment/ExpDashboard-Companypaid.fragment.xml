<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="ExpDash-CompanypaidDialog"
        contentWidth="1000px"
        contentHeight="500px"
        resizable="true"
        draggable="true">
          <customHeader >
        <Bar class="Coursetitle" >
        <contentLeft>
           <Title text="{DialogModel>/Title}" class="Dashboardtitle"/>
        </contentLeft>
          
            <contentRight>
                <Button icon="sap-icon://decline" press="onCloseDialog" tooltip="Close"/>
            </contentRight>
        </Bar>
    </customHeader>
        <content>
          <ScrollContainer
        width="100%"
        height="100%"
        vertical="true"
        horizontal="true"
        focusable="true">
                <Table
                id="idExpenseTable"
                    items="{DialogModel>/Records}"
                    sticky="ColumnHeaders"
                    noDataText="{i18n>noBData}">
                <columns>
                    <Column demandPopin="true" hAlign="Left"><Text text="{i18n>employeeName}" tooltip="{i18n>employeeName}" /></Column>
                    
                    <Column demandPopin="true" width="400px" minScreenWidth="Desktop"><Text text="{i18n>expExpenseName}" tooltip="{i18n>creditNotesAmount}" /></Column>
                    <Column hAlign="Begin" demandPopin="true" minScreenWidth="Desktop"><Text text="{i18n>triptype}" /></Column>
                    <Column hAlign="Begin" demandPopin="true" minScreenWidth="Desktop"><Text text="{i18n>status}"  visible="{DialogModel>/ShowStatus}"/></Column>
                    <Column hAlign="End" demandPopin="true" minScreenWidth="Desktop"><Text text="{i18n>totalAmount}" /></Column>
                  
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press="onPressTableItem">
                        <cells>
                        
                            <ObjectIdentifier title="{DialogModel>EmployeeName}" text="{DialogModel>EmployeeID}" />
                            <Text text="{DialogModel>ExpenseName}" />
                            <Text text="{DialogModel>TripType}" />
                            <Text text="{DialogModel>Status}" visible="{DialogModel>/ShowStatus}" />
                            <Text text="{path: 'DialogModel>TotalAmount', formatter: '.formatter.fromatNumber'} INR" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
            </ScrollContainer>
        </content>
         <footer>
			<Toolbar>
				<ToolbarSpacer/>
				<Text text="Total Amount : " class="Dashboardtitle"/>
				<ObjectNumber number="{parts: [{ path: 'DialogModel>/Amount' }], formatter: '.Formatter.fromatNumber'}" unit="INR" />
        	</Toolbar>
		</footer>
    </Dialog>
</core:FragmentDefinition>