<c:FragmentDefinition
    xmlns="sap.m"
    xmlns:c="sap.ui.core"
>
    <Dialog
        title="{i18n>FillDetails}"
        resizable="true"
        draggable="true"
        contentWidth="40rem"
    >
        <VBox
            id="dynamicForm"
            class="sapUiSmallMargin"
        />
        
       
           	<VBox width="100%" class="sapUiTinyMarginTop fotterbtns">
    <HBox width="100%" justifyContent="End">
                <Button
                    id="MD_id_submitButoon"
                    text="{i18n>submit}"
                    type="Transparent"
                    press="MD_onSubmitButtonPress"
                />
                <Button
                    id="MD_id_saveButoon"
                    text="{i18n>save}"
                    type="Transparent"
                    press="MD_onUpdateButtonPress"
                />

                <Button
                    text="{i18n>CancelButton}"
                    press="MD_onCancelButtonPress"
                    type="Transparent"
                    class="closeBtnMargin"
                />
</HBox>
</VBox>
            
       
    </Dialog>
</c:FragmentDefinition>
