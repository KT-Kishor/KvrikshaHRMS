<c:FragmentDefinition
    xmlns="sap.m"
    xmlns:c="sap.ui.core"
>
    <Dialog
        title="{i18n>FillDetails}"
        resizable="true"
        draggable="true"
        contentWidth="40rem"
    >
        <VBox
            id="dynamicForm"
            class="sapUiSmallMargin"
        />
        
       
           <footer>
    <Toolbar>
        <HBox
            width="100%"
            justifyContent="End"
            alignItems="Center">
                <Button
                    id="MD_id_submitButoon"
                    text="{i18n>submit}"
                    type="Transparent"
                    press="MD_onSubmitButtonPress"
                />
                <Button
                    id="MD_id_saveButoon"
                    text="{i18n>save}"
                    type="Transparent"
                    press="MD_onUpdateButtonPress"
                />

                <Button
                    text="{i18n>CancelButton}"
                    press="MD_onCancelButtonPress"
                    type="Transparent"
                   
                />
</HBox>
    </Toolbar>
</footer>
            
       
    </Dialog>
</c:FragmentDefinition>
