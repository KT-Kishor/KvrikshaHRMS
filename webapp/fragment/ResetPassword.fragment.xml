<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="idCommonDialog"
        contentWidth="450px"
        title="{= ${VisibleModel>/UpdateEmployee} ? ${i18n>reset} : 'Send Timesheet Reminder'}"
    >
        <content>
            <!-- Reset Password -->
            <VBox visible="{VisibleModel>/UpdateEmployee}">
                <f:SimpleForm
                    editable="true"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="4"
                    labelSpanL="3"
                    labelSpanM="4"
                    labelSpanS="12"
                    emptySpanXL="0"
                    emptySpanL="4"
                    emptySpanM="0"
                    emptySpanS="0"
                    columnsXL="2"
                    columnsL="1"
                    columnsM="1"
                >
                    <f:content>
                        <Label
                            text="{i18n>userId}"
                            required="true"
                        />
                        <ComboBox
                            showSecondaryValues="true"
                            id="RP_id_userid"
                            items="{
        path: 'EmpModel>/',
        sorter: [
            {
                path: 'Role', 
                group: true  
            },
            {
            path: 'EmployeeID',
            descending: false
        } 
        ]
    }"
                            filterSecondaryValues="true"
                            valueStateText="{i18n>placeUserId}"
                            change="RP_onSelectUser"
                        >
                            <core:ListItem
                                key="{EmpModel>EmployeeID}"
                                text="{EmpModel>EmployeeID}"
                                additionalText="{EmpModel>EmployeeName}"
                            />
                        </ComboBox>

                        <Label text="{i18n>userName}" />
                        <Input
                            id="RP_id_userName"
                            placeholder="{i18n>placeUserName}"
                            editable="false"
                        />

                        <Label
                            text="{i18n>inpNewpassword}"
                            required="true"
                        />

                        <VBox width="100%">
                            <Input
                                id="RP_id_NewPW"
                                placeholder="{i18n>placenewpass}"
                                liveChange="RP_onChangnewpass"
                                valueStateText="{i18n>passwordValueState}"
                                showValueHelp="true"
                                type="Password"
                                valueState="None"
                                valueHelpIconSrc="sap-icon://show"
                                valueHelpRequest="RP_onTogglePasswordVisibility"
                                maxLength="20"
                                width="100%"
                            />

                            <!-- Link aligned to right -->
                            <HBox
                                justifyContent="End"
                                width="100%"
                            >
                                <Button
                                    text="{i18n>MSgeneratePassword}"
                                    tooltip="{i18n>MSgeneratePassword}"
                                    type="Transparent"
                                    press="SM_onGenerateForgotPassword"
                                />
                            </HBox>
                        </VBox>
                        <Label
                            text="{i18n>inpConpassword}"
                            required="true"
                        />
                        <Input
                            id="RP_id_ConfirmPW"
                            placeholder="{i18n>placeconpass}"
                            liveChange="RP_onChangcomfirmpass"
                            valueStateText="{i18n>valuestaetconpass}"
                            showValueHelp="true"
                            type="Password"
                            valueState="None"
                            change="RP_onComPass"
                            submit="RP_onPressSetSave"
                            valueHelpIconSrc="sap-icon://show"
                            valueHelpRequest="RP_onTogglePasswordVisibility"
                            maxLength="20"
                        />
                    </f:content>
                </f:SimpleForm>
            </VBox>

            <!-- Timesheet Reminder -->
            <VBox
                visible="{VisibleModel>/ReminderTimesheet}"
                class="sapUiMediumMargin"
            >
                <Label text="{i18n>userId}" />
                <CheckBox
                    id="idSelectAll"
                    text="Select All Employees"
                    selected="{VisibleModel>/SelectAll}"
                    select="onSelectAllEmployees"
                />
                <MultiComboBox
                    id="RP_id_Activeuserid"
                    items="{EmpModel>/}"
                    selectionFinish="RP_onSelectUser"
                    showSecondaryValues="true"
                    filterSecondaryValues="true"
                >
                    <core:ListItem
                        key="{EmpModel>EmployeeID}"
                        text="{EmpModel>EmployeeID}"
                        additionalText="{EmpModel>EmployeeName}"
                    />
                </MultiComboBox>
            </VBox>
        </content>

        <footer>
            <Toolbar>
                <HBox
                    width="100%"
                    justifyContent="End"
                    alignItems="Center"
                >
                    <!-- Save Button -->
                    <Button
                        id="RP_id_SavePW"
                        text="{i18n>save}"
                        type="Transparent"
                        class="marginRigth"
                        visible="{VisibleModel>/UpdateEmployee}"
                        press="RP_onPressSetSave"
                    />

                    <!-- Send Reminder Button -->
                    <Button
                        id="idSendReminder"
                        text="Send Reminder"
                        class="marginRigth"
                        visible="{VisibleModel>/ReminderTimesheet}"
                        press="_sendTimesheetReminderEmail"
                    />

                    <!-- Cancel Button -->
                    <Button
                        text="{i18n>btnCancel}"
                        type="Transparent"
                        class="marginRigth"
                        press="RP_onPressCanclePW"
                    />
                </HBox>
            </Toolbar>
        </footer>
    </Dialog>
</core:FragmentDefinition>
