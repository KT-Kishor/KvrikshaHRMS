<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        contentWidth="90%"
        contentHeight="80%"
        draggable="true"
        resizable="true"
    >
        <customHeader>
            <Bar>
                <contentMiddle>
                    <Title text="{i18n>policyVersionHistory}" />
                </contentMiddle>
                <contentRight>
                    <Button
                        icon="sap-icon://decline"
                        type="Transparent"
                        press="onCloseVersionHistory"
                    />
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <Table
                items="{versionModel>/versions}"
                width="100%"
                growing="true"
                growingScrollToLoad="true"
                autoPopinMode="true"
            >
                <columns>
                    <Column
                        width="8rem"
                        demandPopin="true"
                        minScreenWidth="Tablet"
                    >
                        <Text text="{i18n>version}" />
                    </Column>
                    <Column
                        width="10rem"
                        demandPopin="true"
                        minScreenWidth="Tablet"
                    >
                        <Text text="{i18n>startDate}" />
                    </Column>
                    <Column
                        width="10rem"
                        demandPopin="true"
                        minScreenWidth="Desktop"
                    >
                        <Text text="{i18n>endDate}" />
                    </Column>
                    <Column
                        width="6rem"
                        hAlign="Center"
                    >
                        <Text text="{i18n>download}" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <ObjectStatus
                                text="{versionModel>Version}"
                                state="None"
                            />

                            <Text
                                text="{
                                    path: 'versionModel>Start_Date',
                                    type: 'sap.ui.model.type.Date',
                                    formatOptions: {
                                        pattern: 'dd/MM/yyyy'
                                    }
                                }"
                            />

                            <Text
                                text="{
                                    path: 'versionModel>End_Date',
                                    type: 'sap.ui.model.type.Date',
                                    formatOptions: {
                                        pattern: 'dd/MM/yyyy'
                                    }
                                }"
                            />

                            <Button
                                icon="sap-icon://pdf-attachment"
                                type="Emphasized"
                                tooltip="Download PDF"
                                press="onDownloadVersionPdf"
                            />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Dialog>
</core:FragmentDefinition>
