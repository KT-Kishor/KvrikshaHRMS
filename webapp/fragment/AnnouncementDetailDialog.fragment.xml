<core:FragmentDefinition xmlns:vbm="sap.ui.vbm"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
    xmlns:layout="sap.ui.layout"

>
	<Dialog
        id="ANC_id_DetailDialog"
       contentWidth="800px"
        contentHeight="800px"
        verticalScrolling="false"
    >
     <customHeader>
            <Bar>

                <contentMiddle>
                    <Title  text="{Announcements>AnnouncementTitle}"/>
                </contentMiddle>

                <contentRight>
                    <Button
                        icon="sap-icon://exit-full-screen"
                        type="Transparent"
                        press="ANC_onCloseDetailDialog"/>
                </contentRight>

            </Bar>
        </customHeader>
		<content>
        <ScrollContainer
                    vertical="true"
                    horizontal="false"
                    height="100%"
                    class="sapUiTinyMargin" id="ANC_id_ScrollContainer">
			<VBox width="100%">
				<!-- ================= HERO IMAGE ================= -->
				<!-- <VBox
                    width="100%"
                    class="sapUiNoContentPadding dialogAnnouncementHero"
                > -->
					<!-- Background Image -->
					<!-- <Image
                        src="{path:'Announcements>AnnouncementBackground',formatter:'.ANC_formatBase64Image'}"
                        visible="{path:'Announcements>AnnouncementBackground',formatter:'.ANC_hasValue'}"
                        width="100%"
                        height="220px"
                        decorative="false"
                    /> -->
				<!-- </VBox> -->
                
                 <VBox class="announcementDetailsCard sapUiTinyMargin">

    <layout:Grid
        defaultSpan="XL6 L6 M6 S12"
        hSpacing="1"
        vSpacing="1">

        <!-- Created Date -->
        <HBox alignItems="Center">
            <Label
                text="{i18n>CreatedDate}"
                width="120px"
                design="Bold"/>
            <Text
                text="{path:'Announcements>CreatedDate', formatter:'.Formatter.formatDate'}"/>
        </HBox>

        <!-- Attachment -->
        <HBox alignItems="Center">
            <Label
                text="{i18n>Attachment}"
                width="120px"
                design="Bold"/>
            <Link
                text="{i18n>viewAttachment}"
                class="footer-CoName"
                visible="{path:'Announcements>AnnouncementAttachment', formatter:'.ANC_hasValue'}"
                press="ANC_onAttachmentPress"/>
        </HBox>

        <!-- Created By -->
        <HBox alignItems="Center">
            <Label
                text="{i18n>CreatedBy}"
                width="120px"
                design="Bold"/>
            <Text text="{Announcements>CreatedBy}"/>
        </HBox>
        <HBox alignItems="Center">
            <Label
                text="{i18n>Priority}"
                width="120px"
                design="Bold"/>
            <Text text="{Announcements>Priority}"/>
        </HBox>

        <!-- Status -->
        <HBox alignItems="Center">
            <Label
                text="{i18n>status}"
                width="120px"
                design="Bold"/>
            <ObjectStatus
                text="{path:'Announcements>AnnouncementStatus', formatter:'.Formatter.formatStatusText'}"
                state="{path:'Announcements>AnnouncementStatus', formatter:'.Formatter.formatObjectStatus'}"/>
        </HBox>
        <HBox
        alignItems="Center"
        width="100%"
        visible="{visibilityModel>/showAdminControls}">
        <Label
            text="{i18n>departmentAnnouncement}"
            width="120px"
            design="Bold"/>
        <Text
            text="{Announcements>AnnouncementDepartment}"
            wrapping="true"/>
    </HBox>
         <HBox
        alignItems="Center"
        width="100%"
        visible="{visibilityModel>/showAdminControls}">
        <Label
            text="{i18n>ExpiresDate}"
            width="120px"
            design="Bold"/>
        <Text
            text="{path:'Announcements>ExpiresDate', formatter:'.Formatter.formatDate'}"/>
    </HBox>

    </layout:Grid>

</VBox>
              
				<!-- ================= BODY ================= -->
				<!-- <VBox class="sapUiSmallMargin" renderType="Bare"> -->
                
                    <VBox class="announcementDetailsCard sapUiTinyMargin" >
                        <Label
            text="{i18n>AnnouncementMessage}"
            class="sapUiTinyMarginBottom"
            design="Bold"/>
                       <Text
                        text="{Announcements>AnnouncementMessage}"
                        wrapping="true"
                    />
                    </VBox>

              
			
			</VBox>
              </ScrollContainer>
		</content>
	</Dialog>
</core:FragmentDefinition>