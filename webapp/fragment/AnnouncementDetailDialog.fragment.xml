<core:FragmentDefinition xmlns:vbm="sap.ui.vbm"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
    xmlns:layout="sap.ui.layout"

>
	<Dialog
        id="ANC_id_DetailDialog"
       contentWidth="800px"
        contentHeight="800px"
        verticalScrolling="false"
    >
     <customHeader>
            <Bar>

                <contentMiddle>
                    <Title text="Announcement Details"/>
                </contentMiddle>

                <contentRight>
                    <Button
                        icon="sap-icon://exit-full-screen"
                        type="Transparent"
                        press="ANC_onCloseDetailDialog"/>
                </contentRight>

            </Bar>
        </customHeader>
		<content>
			<VBox width="100%">
				<!-- ================= HERO IMAGE ================= -->
				<VBox
                    width="100%"
                    class="sapUiNoContentPadding dialogAnnouncementHero"
                >
					<!-- Background Image -->
					<Image
                        src="{path:'Announcements>AnnouncementBackground',formatter:'.ANC_formatBase64Image'}"
                        visible="{path:'Announcements>AnnouncementBackground',formatter:'.ANC_hasValue'}"
                        width="100%"
                        height="220px"
                        decorative="false"
                    />
					
					<VBox
                        class="dialogOverlayContent"
                    >
						<Title
                            id="ANC_id_DetailTitle"
                            text="{Announcements>AnnouncementTitle}"
                            level="H3"
                            wrapping="true"
                            class="dialogTitleText sapUiTinyMarginBottom"
                        />
                          <HBox
        visible="{visibilityModel>/showAdminControls}"
        alignItems="Center"
        class="sapUiTinyMarginBottom">
        
						<Label
                        visible="{visibilityModel>/showAdminControls}"
                            id="ANC_id_DetailExpiresLabel"
                            text="{i18n>ExpiresDate}"
                            class="dateText sapUiTinyMarginBottom sapUiTinyMarginEnd"
                        />
						<Text
                        visible="{visibilityModel>/showAdminControls}"
                            id="ANC_id_DetailExpiresText"
                            text="{
                                path:'Announcements>ExpiresDate',
                                formatter:'.Formatter.formatDate'
                            }"
                            class="dateText sapUiTinyMarginBottom"
                        />
                        </HBox>
                        <FlexBox
    visible="{visibilityModel>/showAdminControls}"
    wrap="Wrap"
    alignItems="Start"
    class="sapUiTinyMarginBottom">
                        <Label
                        visible="{visibilityModel>/showAdminControls}"
                            id="ANC_id_departmentLabel"
                            text="{i18n>departmentAnnouncement}"
                            class="dateText sapUiTinyMarginBottom sapUiTinyMarginEnd"
                        />
                        <Text
                        visible="{visibilityModel>/showAdminControls}"
                            id="ANC_id_DetailDepartmentText"
                            text="{Announcements>AnnouncementDepartment}"
                            class="dateText sapUiTinyMarginBottom"
                        />
                        </FlexBox>
					</VBox>
				</VBox>
              
                 <ScrollContainer
                    vertical="true"
                    horizontal="false"
                    height="320px"
                    width="100%"
                    class="sapUiSmallMarginTop" id="ANC_id_ScrollContainer">
            <VBox class="announcementDetailsCard sapUiSmallMargin">

    <layout:Grid
        defaultSpan="XL6 L6 M6 S12"
        hSpacing="2"
        vSpacing="1">

        <!-- Created Date -->
        <HBox alignItems="Center">
            <Label
                text="{i18n>CreatedDate}"
                width="120px"
                design="Bold"/>
            <Text
                text="{path:'Announcements>CreatedDate', formatter:'.Formatter.formatDate'}"/>
        </HBox>

        <!-- Attachment -->
        <HBox alignItems="Center">
            <Label
                text="{i18n>Attachment}"
                width="120px"
                design="Bold"/>
            <Link
                text="{i18n>viewAttachment}"
                class="footer-CoName"
                visible="{path:'Announcements>AnnouncementAttachment', formatter:'.ANC_hasValue'}"
                press="ANC_onAttachmentPress"/>
        </HBox>

        <!-- Created By -->
        <HBox alignItems="Center">
            <Label
                text="{i18n>CreatedBy}"
                width="120px"
                design="Bold"/>
            <Text text="{Announcements>CreatedBy}"/>
        </HBox>

        <!-- Status -->
        <HBox alignItems="Center">
            <Label
                text="{i18n>status}"
                width="120px"
                design="Bold"/>
            <ObjectStatus
                text="{path:'Announcements>AnnouncementStatus', formatter:'.Formatter.formatStatusText'}"
                state="{path:'Announcements>AnnouncementStatus', formatter:'.Formatter.formatObjectStatus'}"/>
        </HBox>

    </layout:Grid>

</VBox>
                
              
				<!-- ================= BODY ================= -->
				<!-- <VBox class="sapUiSmallMargin" renderType="Bare"> -->
                

                    <VBox class="sapUiSmallMargin" >

                       <Text
                        text="{Announcements>AnnouncementMessage}"
                        wrapping="true"
                    />
                    </VBox>

                </ScrollContainer>
			
			</VBox>
		</content>
	</Dialog>
</core:FragmentDefinition>