<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="pdfDialog"
        title="View Attachment"
        stretch="true"
        contentWidth="100%"
        contentHeight="100%"
        draggable="false"
        resizable="false">

        <content>

            <VBox
                width="100%"
                height="100%"
                fitContainer="true">

                <PDFViewer
                    id="pdfViewer"
                    source="{pdfModel>/pdfSource}"
                    width="100%"
                    height="100%"
                    displayType="Embedded"
                    showDownloadButton="true"/>

            </VBox>

        </content>

        <endButton>
            <Button
                text="Close"
                press="ANC_onClosePDFDialog"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>