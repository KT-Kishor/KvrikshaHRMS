<core:FragmentDefinition
    xmlns:odata="sap.ui.comp.odata"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
>
    <Dialog
        title="{i18n>CreateGoals}"
        contentWidth="700px"
        contentHeight="auto"
        draggable="true"
        class="sapUiResponsivePadding customGoalDialog"
    >
        <customHeader>
            <Bar>
                <contentLeft>
                    <Title text="{i18n>CreateGoals}" />
                </contentLeft>
                
            </Bar>
        </customHeader>

        <content>
            <VBox class="sapUiSmallMargin">

                <Label
                    text="{i18n>topic}"
                />

                <ComboBox
    id="topicCombo"
    width="100%"
    selectedKey="{viewModel>/selectedCategory}"
    selectionChange="FMG_onCategoryChange"
    items="{topicModel>/topics}"
   
>
    <core:Item
        key="{topicModel>Topic}"
        text="{topicModel>Topic}"
    />
</ComboBox>

                <!-- QUESTION -->
                <Label
                    text="{i18n>Question}"
                    required="true"
                    class="sapUiTinyMarginTop"
                />

                <ComboBox
                    id="FMG_id_QuestionBox"
                    items="{viewModel>/questionsList}"
                    selectedKey="{viewModel>/selectedQuestion}"
                    width="100%"
                    
                    change="FMG_onQuestionSelect"
                
                >
                    <core:Item
                        key="{viewModel>Question}"
                        text="{viewModel>Question}"
                    />
                </ComboBox>

                <Label
                    text="{i18n>Goaldescriptor}"
                    required="true"
                    class="sapUiTinyMarginTop"
                />

                <!-- DESCRIPTION -->
                <TextArea
                    id="FMG_id_DescriptionBox"
                    value="{viewModel>/description}"
                    growing="true"
                    rows="7"
                    growingMaxLines="4"
                    width="100%"
                    maxLength="500"
                    liveChange="MG_onDescriptionChange"
                    valueStateText="{i18n>enterDescription}"
                />

                <Label
                    text="{i18n>SelectQuarter}"
                    class="sapUiTinyMarginTop"
                    required = "true"
                />

                <SegmentedButton
                    id="FMG_id_QuarterButton"
                    selectedKey="{viewModel>/selectedQuarter}"
                    selectionChange="FMG_onQuarterSelect"
                    width="100%"
                    enabled="{= !${viewModel>/isEditMode} }"
                >
                    <items>
                        <SegmentedButtonItem
                            key="Q1"
                            text="{i18n>Q1}"
                            enabled="{= !${viewModel>/usedQuarters/${= ${viewModel>/currentYear} }/Q1} }"
                        />

                        <SegmentedButtonItem
                            key="Q2"
                            text="{i18n>Q2}"
                            enabled="{= !${viewModel>/usedQuarters/${= ${viewModel>/currentYear} }/Q2} }"
                        />

                        <SegmentedButtonItem
                            key="Q3"
                            text="{i18n>Q3}"
                            enabled="{= !${viewModel>/usedQuarters/${= ${viewModel>/currentYear} }/Q3} }"
                        />

                        <SegmentedButtonItem
                            key="Q4"
                            text="{i18n>Q4}"
                            enabled="{= !${viewModel>/usedQuarters/${= ${viewModel>/currentYear} }/Q4} }"
                        />
                    </items>
                </SegmentedButton>

            </VBox>
        </content>

      <VBox width="100%" class="sapUiSmallMarginTop fotterbtns">
    <HBox width="100%" justifyContent="End">
            <Button
                text="{i18n>save}"
                press="FMG_onSave"
                type="Transparent"
            />

            <Button
                text="{i18n>Cancel}"
                type="Transparent"
                press="FMG_onCancel"
                class="closeBtnMargin"
            />
       </HBox>
       </VBox>
    </Dialog>
</core:FragmentDefinition>