<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:f="sap.ui.layout.form"
	xmlns:core="sap.ui.core"
    xmlns:rich="sap.ui.richtexteditor"
>
    <Dialog
        title="{i18n>previewLetter}"
        contentWidth="85%"
        contentHeight="75%"
    >
        <rich:RichTextEditor
            id="FCR_id_RTE"
            width="100%"
            height="75vh"
            showGroupFontStyle="true"
            showGroupTextAlign="true"
            showGroupStructure="true"
            value="{PDFData>/RTEText}"
			visible="true"
        />
     <footer>
    <Toolbar>
        <HBox
            width="100%"
            justifyContent="End"
            alignItems="Center">
            <Button
                text="{i18n>GeneratePDF}"
                type="Transparent"
                press=".FCR_onDownloadPDF"
                class="submit"
            />
        
            <Button
                text="{i18n>close}"
                type="Transparent"
                press=".FCR_onCloseDialog"
                class="sendMail"
            />
      </HBox>
    </Toolbar>
</footer>
    </Dialog>

</core:FragmentDefinition>