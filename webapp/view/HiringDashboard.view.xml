<mvc:View
  controllerName="sap.kt.com.minihrsolution.controller.HiringDashboard"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:fb="sap.ui.comp.filterbar"
  displayBlock="true">
<Page
  id="HD_id_Page"
  >
  <!-- HEADER -->
  <customHeader>
    <core:Fragment
      fragmentName="sap.kt.com.minihrsolution.fragment.Header"
      type="XML" />
  </customHeader>
  <content>
    <!-- ================= FILTER BAR ================= -->
<fb:FilterBar
  id="filterBar2"
  useToolbar="false"
  showClearOnFB="true"
  showFilterConfiguration="false"
  search="onFilterSearch"
  clear="onFilterClear"
  class="sapUiTinyMargin CommonRoundedTable">
  <fb:filterGroupItems>

    <!-- NAME SEARCH -->
    <fb:FilterGroupItem
      name="candidate_Name"
      label="{i18n>Search}"
      groupName="General"
      visibleInFilterBar="true">

      <fb:control>
        <Input
          id="nameInput"
          placeholder="{i18n>searchPlaceholder}"
          liveChange="onLiveSearch"
          showClearIcon="true"/>
      </fb:control>

    </fb:FilterGroupItem>

    <!-- SKILL -->
    <fb:FilterGroupItem
      name="skill_level"
      label="{i18n>skillFilterLabel}"
      groupName="General"
      visibleInFilterBar="true">

      <fb:control>
        <Select id="skillSelect" change="onFilterChange" >
          <core:Item key="" text="{i18n>filterAll}"/>
          <core:Item key="beginner" text="{i18n>skillBeginner}"/>
          <core:Item key="intermediate" text="{i18n>skillIntermediate}"/>
          <core:Item key="expert" text="{i18n>skillExpert}"/>
        </Select>
      </fb:control>

    </fb:FilterGroupItem>

    <!-- LANGUAGE -->
    <fb:FilterGroupItem
      name="preferred_language"
      label="{i18n>languageFilterLabel}"
      groupName="General"
      visibleInFilterBar="true">

      <fb:control>
        <Select id="langSelect" change="onFilterChange">
          <core:Item key="" text="{i18n>filterAll}"/>
          <core:Item key="Java" text="{i18n>langJava}"/>
          <core:Item key="JavaScript" text="{i18n>langJavaScript}"/>
          <core:Item key="Python" text="{i18n>langPython}"/>
        </Select>
      </fb:control>
    </fb:FilterGroupItem>
  </fb:filterGroupItems>
</fb:FilterBar>

    <!-- ================= TABLE ================= -->
   <Table id="candidateTable" items="{candidateModel>/candidates}" busyIndicatorDelay="0" growing="true" growingThreshold="10" alternateRowColors="true" width="auto"
 growingTriggerText="{i18n>loadMoreBtn}" updateFinished="onUpdateFinished" class="sapUiTinyMargin CommonRoundedTable hideGrowingInfo .sapMGrowingListDescription">
  <!-- HEADER TOOLBAR -->
  <headerToolbar>
    <OverflowToolbar>
      
      <!-- <Title text="{= ${i18n>candidatesTitlePrefix} + ' (' + ${candidateModel>/candidates}.length + ')' }" level="H2"/> -->
      <Title
    text="{= ${i18n>candidatesTitlePrefix} + ' (' + ${viewModel>/candidateCount} + ')' }"
    level="H2"/>

      <ToolbarSpacer />

      <!-- DASHBOARD BUTTON (RIGHT SIDE) -->
      <Button
        text="{i18n>dashboardBtn}"
       
        icon="sap-icon://business-objects-experience"
        press="onGoToDashboard" />

    </OverflowToolbar>
  </headerToolbar>

      <columns>
    <Column width="5rem">
        <Text text="{i18n>colPhoto}"/>
    </Column>

    <!-- ID Column (Reduced Width) -->
    <Column width="6rem">
        <Text text="{i18n>studentId}"/>
    </Column>

    <Column minScreenWidth="Tablet" demandPopin="true" width="12rem">
        <Text text="{i18n>colName}"/>
    </Column>

    <!-- Email Column (Increased Width) -->
    <Column minScreenWidth="Tablet" demandPopin="true" width="20rem">
        <Text text="{i18n>colEmail}"/>
    </Column>

    <Column minScreenWidth="Tablet" demandPopin="true" width="10rem">
        <Text text="{i18n>colSkill}"/>
    </Column>

    <Column minScreenWidth="Tablet" demandPopin="true" width="10rem">
        <Text text="{i18n>colLanguage}"/>
    </Column>

    <Column minScreenWidth="Tablet" demandPopin="true" width="10rem">
        <Text text="{i18n>colStatus}"/>
    </Column>
</columns>
      <items>
        <ColumnListItem>
          <cells>
            <Avatar src="{candidateModel>Photo}" displaySize="S" displayShape="Circle" fallbackIcon="sap-icon://person-placeholder" />
            <Text text="{candidateModel>student_Id}" />
            <Text text="{candidateModel>candidate_Name}" />
            <Text text="{candidateModel>candidate_Email}" />
            <Text text="{candidateModel>skill_level}" />
            <Text text="{candidateModel>preferred_language}" />
            <Text text="{candidateModel>Status}" />
          </cells>
        </ColumnListItem>
      </items>
    </Table>

  </content>
  <footer>
            <Bar>
                <contentLeft>
                    <core:Fragment fragmentName="sap.kt.com.minihrsolution.fragment.Footer" type="XML"/>
                </contentLeft>
            </Bar>
        </footer>
</Page>

</mvc:View>