<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:mc="sap.suite.ui.microchart" xmlns:card="sap.f.cards" xmlns:f="sap.f" controllerName="sap.kt.com.minihrsolution.controller.ExpenseDashBoard" xmlns:core="sap.ui.core" displayBlock="true" xmlns:layout="sap.ui.layout" xmlns:com="sap.suite.ui.commons" xmlns:viz="sap.viz.ui5.controls"
	xmlns:vizFeeds="sap.viz.ui5.controls.common.feeds"
	xmlns:vizData="sap.viz.ui5.data" xmlns:fb="sap.ui.comp.filterbar" xmlns:c="sap.suite.ui.microchart">

<Page id="dashboardPage" class="glassHeader classheader" >
<customHeader>
<Bar>
<contentLeft>
 <Button      icon="sap-icon://home"
                type="Transparent"
                press="onPressback"/>

            <Title text="Company Expense Dashboard" level="H2"/>
</contentLeft>
<contentRight>
  
          <Button
            press="Tile_NotifictionBTN"
            class="sapUiTinyMarginBeginEnd logoutBtn"
            tooltip="{i18n>TilenotificationfragName}"
            icon="sap-icon://bell"
            type="Transparent"
            visible="{= ${LoginModel>/Role} !== 'Contractor' }"
        >
            <customData>
                <BadgeCustomData
                    class="badgeClass"
                    key="badge"
                    value="{EndingSoonModel>/notificationCount}"
                />
            </customData>
        </Button>

       <Button
            press="TP_onraisebugpress"
            icon="sap-icon://incident"
            tooltip="{i18n>raisebug}"
            type="Transparent"
            class="Bug"
        />

        <Button
            press="onLogout"
            icon="sap-icon://log"
            tooltip="{i18n>logoutTooltip}"
            type="Transparent"
            class="logoutBtn"
        />
   

</contentRight>
</Bar>
</customHeader>


<content>
<!--  KPI Tiles  -->
<VBox class="sapUiSmallMargin">

    <fb:FilterBar id="Expdashboardfilter"  useToolbar="false" clear="onClearFilters" showClearOnFB="true" search="onSearchDashboard" class="sapUiTinyMargin CommonRoundedTable" showFilterConfiguration="false">
					<fb:filterGroupItems>
						<fb:FilterGroupItem name="daterange" label="Date Range" groupName="Group1" visibleInFilterBar="true">
							<fb:control>
								 <DateRangeSelection
            id="idFinancialYear"
            width="18rem"
            displayFormat="dd/MM/yyyy"
             class="sapUiMediumMarginEnd"/>
							</fb:control>
						</fb:FilterGroupItem>
						
					</fb:filterGroupItems>
				</fb:FilterBar>

</VBox>


 <FlexBox
                    wrap="Wrap"
                    justifyContent="Center"
                    alignItems="Start"
                    class="invoiceTileContainer sapUiSmallMarginBottom">

        <!-- Total Spend -->
        <GenericTile
                                    class="tileLayout customTileWidth1  blueTile"
                                    header="{= 'Previous FY : ' + ${DashboardModel>/PreFinancialYear} }"
                                    frameType="TwoByOne"
                                    press="onPressManageJobs"
                                >
                                    <tileContent>
                                        <TileContent >
                                            <content>
                                                <c:ComparisonMicroChart
                                                    view="Wide"
                                                    size="L"
                                                    class="custommicrochat"
                                                >
                                                    <c:data>   
                                                    <c:ComparisonMicroChartData
                                                            title="Open"
                                                            value="{DashboardModel>/PreOpenAmount}"
                                                           displayValue="{
                                path:'DashboardModel>/PreOpenAmount',
                                formatter:'.Formatter.CurrencyInINRExpense'
                            }"
                                                            color="Error"
                                                        /> 
                                                         <c:ComparisonMicroChartData
                                                            title="Pending"
                                                            value="{DashboardModel>/PrePendingAmount}"
                                                           displayValue="{
                                path:'DashboardModel>/PrePendingAmount',
                                formatter:'.Formatter.CurrencyInINRExpense'
                            }"
                                                            color="Error"
                                                        />
                                                        <c:ComparisonMicroChartData
                                                            title="Paid"
                                                             value="{DashboardModel>/PreReimbursementAmount}"
                                                            displayValue="{
                                path:'DashboardModel>/PreReimbursementAmount',
                                formatter:'.Formatter.CurrencyInINRExpense'
                            }"
                                                            color="Good"
                                                        />
                                                        <c:ComparisonMicroChartData
                                                             value="{DashboardModel>/PreTotalAmount}"
                                                            title="Total"
                                                             displayValue="{
                                path:'DashboardModel>/PreTotalAmount',
                                formatter:'.Formatter.CurrencyInINRExpense'
                            }"
                                                            color="Neutral"
                                                         />
                                                        
                                                       
                                                        
                                                       
                                                    </c:data>
                                                </c:ComparisonMicroChart>
                                            </content>
                                        </TileContent>
                                    </tileContent>
                                </GenericTile>
<GenericTile
            class="tileLayout dashTile blueTile"
            header="{i18n>openexpense}"
            subheader="{= ${DashboardModel>/First4Card/OpenCount} + ' Open Claims' }"
            press="onOpenexpenseTilePress">

            <tileContent>
                <TileContent >
                    <content>
                        <NumericContent
                        class="sapUiSmallMarginTop" 
                           value="{path:'DashboardModel>/First4Card/OpenAmount',
                            formatter:'.formatter.fromatNumberinvoice'}"
                            valueColor="Error"
                            indicator="Down"
                            icon="sap-icon://batch-payments"
                            scale="K" />
                    </content>
                </TileContent>
            </tileContent>
        </GenericTile>


          <!-- Pending -->
        <GenericTile
            class="tileLayout dashTile redTile"
            header="{i18n>pendingExpense}"
            subheader="{= ${DashboardModel>/PendingCount} + ' Open Claims' }"
            press="onPendingTilePress">

            <tileContent>
                <TileContent >
                    <content>
                        <NumericContent
                        class="sapUiSmallMarginTop" 
                           value="{path:'DashboardModel>/First4Card/PendingAmount',
                            formatter:'.formatter.fromatNumberinvoice'}"
                            valueColor="Error"
                            indicator="Down"
                            icon="sap-icon://pending"
                            scale="K" />
                    </content>
                </TileContent>
            </tileContent>
        </GenericTile>

        <!-- Reimbursement -->
        <GenericTile
            class="tileLayout dashTile greenTile "
            header="{i18n>paidexpense}"
            subheader="{= ${DashboardModel>/ReimbursementCount} + ' Open Claims' }"
            press="onReimbursementTilePress">

            <tileContent>
                <TileContent  >
                    <content>
                        <NumericContent
                        icon="sap-icon://payment-approval"
                            value="{path:'DashboardModel>/First4Card/ReimbursementAmount',
                            formatter:'.formatter.fromatNumberinvoice'}"
                            class="sapUiSmallMarginTop"
                            indicator="Up"
                            valueColor="Good"
                            scale="K" />
                    </content>
                </TileContent>
            </tileContent>
        </GenericTile>

      
         <GenericTile
            class="tileLayout dashTile blueTile "
            header="{i18n>totalexpense}"
            subheader="{= ${DashboardModel>/First4Card/TotalClaims} + ' Open Claims' }"
            press="onTotalExpenseTilePress">

            <tileContent>
                <TileContent >
                    <content>
                        <NumericContent
                        class="sapUiSmallMarginTop"
                           value="{path:'DashboardModel>/First4Card/TotalAmount',
                            formatter:'.formatter.fromatNumberinvoice'}"
                            scale="K" 
                            icon="sap-icon://money-bills"
                            indicator="Up"
                            valueColor="Good"/>
                    </content>
                </TileContent>
            </tileContent>
        </GenericTile>
        

    </FlexBox>
    

<layout:Grid defaultSpan="XL6 L6 M12 S12"  hSpacing="1" vSpacing="1">
					<layout:content>
                    
                    <f:Card class="sapUiTinyMarginBottom">

    <f:header>
        <card:Header
            title="{i18n>monthlyexpensetrend}"
            subtitle="{i18n>financialyearoverview}"/>
    </f:header>

    <f:content>

        <viz:VizFrame
            id="monthlyExpenseChart"
            vizType="line"
            width="100%"
            height="350px"
            selectData="onMonthlyExpenseChartSelect"
            uiConfig="{applicationSet:'fiori'}">

            <viz:dataset>
                <vizData:FlattenedDataset
                    data="{DashboardModel>/MonthlyTrend}">

                    <vizData:dimensions>
                        <vizData:DimensionDefinition
                            name="Month"
                            value="{DashboardModel>Month}" />
                    </vizData:dimensions>

                    <vizData:measures>
                        <vizData:MeasureDefinition
                            name="Expense Amount"
                            value="{DashboardModel>TotalAmount}" />
                    </vizData:measures>

                </vizData:FlattenedDataset>
            </viz:dataset>

            <viz:feeds>
                <vizFeeds:FeedItem
                    uid="valueAxis"
                    type="Measure"
                    values="Expense Amount"/>

                <vizFeeds:FeedItem
                    uid="categoryAxis"
                    type="Dimension"
                    values="Month"/>
            </viz:feeds>

        </viz:VizFrame>

    </f:content>

</f:Card>
						
<!-- second chart  -->

<f:Card class="sapUiTinyMarginBottom">

<f:header>
        <card:Header
            title="{i18n>paymentbreakdown}"
           subtitle="{
    parts: [
        { path: 'DashboardModel>/PaymentPendingAmount' },
        { path: 'DashboardModel>/PaymentReimbursementAmount' },
        { path: 'DashboardModel>/PaymentOpenAmount' }
    ],
    formatter: '.formatter.formatPaymentSubtitle'
}"/>
    </f:header>

    <f:content>
        <viz:VizFrame
            id="paymentDonutChart"
            vizType="donut"
            width="100%"
            selectData="onPaymentChartSelect"
            height="350px"
            vizProperties="{
                title: { visible: false },
                legend: { visible: true },
                plotArea: {
                    dataLabel: {
                        visible: true,
                        type: 'value'
                    }
                }
            }">

            <viz:dataset>
                <vizData:FlattenedDataset
                    data="{PaymentChartModel>/PaymentData}">

                    <vizData:dimensions>
                        <vizData:DimensionDefinition
                            name="Payment Type"
                            value="{PaymentChartModel>Type}" />
                    </vizData:dimensions>

                    <vizData:measures>
                        <vizData:MeasureDefinition
                            name="Amount"
                            value="{PaymentChartModel>Amount}" />
                    </vizData:measures>

                </vizData:FlattenedDataset>
            </viz:dataset>

            <viz:feeds>
                <vizFeeds:FeedItem
                    uid="size"
                    type="Measure"
                    values="Amount" />

                <vizFeeds:FeedItem
                    uid="color"
                    type="Dimension"
                    values="Payment Type" />
            </viz:feeds>

        </viz:VizFrame>
        

    </f:content>
</f:Card>


<!-- Third chart -->


<f:Card  class="sapUiTinyMarginBottom">

    <f:header>
        <card:Header
            title="{i18n>triptypeanalysis}"
            subtitle="{i18n>expensebytriptype}"/>
    </f:header>

    <f:content>

        <viz:VizFrame
            id="tripTypeBarChart"
            vizType="column"
            width="100%"
            height="350px"
             selectData="onTripTypeBarChartSelect"
            uiConfig="{applicationSet:'fiori'}">

            <viz:dataset>
                <vizData:FlattenedDataset
                    data="{DashboardModel>/TripTypeData}">

                    <vizData:dimensions>
                        <vizData:DimensionDefinition
                            name="Trip Type"
                            value="{DashboardModel>TripType}" />
                    </vizData:dimensions>

                    <vizData:measures>
                        <vizData:MeasureDefinition
                            name="Amount"
                            value="{DashboardModel>Amount}" />
                    </vizData:measures>

                </vizData:FlattenedDataset>
            </viz:dataset>

            <viz:feeds>
                <vizFeeds:FeedItem
                    uid="valueAxis"
                    type="Measure"
                    values="Amount"/>

                <vizFeeds:FeedItem
                    uid="categoryAxis"
                    type="Dimension"
                    values="Trip Type"/>
            </viz:feeds>

        </viz:VizFrame>

    </f:content>

</f:Card>
<!-- 4. category Distribution Chart -->
						<f:Card class="sapUiTinyMarginBottom">
                        
    <f:header>
        <card:Header
            title="{i18n>spendbyucategory}"
            subtitle="{i18n>expensetypedistribution}"/>
    </f:header>

    <f:content>
     <ScrollContainer
            height="350px"
            width="100%"
            vertical="true"
            horizontal="false">
        <List
            items="{DashboardModel>/ByExpenseType}"
            showSeparators="None">

            <CustomListItem>
                <HBox
                    width="100%"
                    alignItems="Center"
                    class="sapUiSmallMargin">

                    <!-- Icon -->
                    <core:Icon
    src="{
        path: 'DashboardModel>ItemType',
        formatter: '.formatter.getItemTypeIcon'
    }"
    size="1.5rem"
    class="categoryIcon sapUiTinyMarginEnd"/>

                    <!-- Category + Progress -->
                    <VBox width="70%" class="sapUiSmallMarginBottom">
                        <Text
                            text="{DashboardModel>ItemType}"
                           
                           />

                        <ProgressIndicator
                            percentValue="{DashboardModel>Percentage}"
                            displayValue="{DashboardModel>Percentage}%"
                            showValue="false"
                            width="100%"
                            state="Success"/>
                    </VBox>

                    <!-- Amount -->
                    <Text
                        text="{path: 'DashboardModel>Amount', formatter: '.formatter.CurrencyInINRExpense'}"
                        class="sapUiMediumMarginBegin categoryAmount"/>

                </HBox>
            </CustomListItem>

        </List>
        </ScrollContainer>
    </f:content>
</f:Card>

					</layout:content>
				</layout:Grid>

            
                <VBox
    id="employeeTableBox"
    visible="{= !${viewModel>/showGraph}}"
    class="flipCard">
              <f:Card class="sapUiSmallMarginBeginEnd sapUiTinyMarginBottom" width="auto"  >


    <f:content>
                        <ScrollContainer
                            vertical="true"
                            horizontal="true">

                            <Table
                            id="idTop10ExpensesTable"
                                width="100%"
                                items="{DashboardModel>/EmployeeExpenses}"
                                sticky="HeaderToolbar,ColumnHeaders" >
                                <headerToolbar>
    <Toolbar >
        <FlexBox
            width="100%"
            wrap="Wrap"
            justifyContent="SpaceBetween"
            alignItems="Center">

            <Title
                text="{i18n>top10expense}"
                level="H4" />
                <ToolbarSpacer />
        <HBox
            alignItems="Center"
            justifyContent="End"
            renderType="Bare">

            <Button
                text="{= ${viewModel>/showGraph} ? ${i18n>Table} : ${i18n>Graph}}"
                press="ED_onClickEmpExp"
                class="sapUiTinyMarginEnd"/>

            <SearchField
                width="20rem"
                liveChange="onGlobalSearch"
                placeholder="{i18n>search}" />

        </HBox>

        </FlexBox>
    </Toolbar>
</headerToolbar>

                               <columns>

                <Column minScreenWidth="Tablet"
                       demandPopin="true">
                    <Text text="{i18n>employee}"/>
                </Column>

                <Column minScreenWidth="Tablet"
                                                                demandPopin="true">
                    <Text text="{i18n>expDetExpenseAmount}"/>
                </Column>
                <Column minScreenWidth="Tablet"
                                                                demandPopin="true">
                    <Text text="{i18n>view}"/>
                </Column>

              
            </columns>

            <items>
                <ColumnListItem   press="onPressTop10Item">

                    <cells>
                        <!-- Expense -->
                       <ObjectIdentifier
                                    title="{DashboardModel>EmployeeName}" 
                                    text="{DashboardModel>EmployeeID}"/>
                        <!-- Amount -->
                        <Text
                            text="{path: 'DashboardModel>TotalAmount', formatter: '.formatter.fromatNumberexpense'}"
                            />
                        <Button text="{i18n>View}" press="ED_onShowEmployeeExp" />

                       

                    </cells>

                </ColumnListItem>
            </items>

                            </Table>
                            

                        </ScrollContainer>

    </f:content>

</f:Card>
</VBox>

<VBox
    id="employeeChartBox"
    visible="{viewModel>/showGraph}"
    class="flipCard">

    <HBox
        justifyContent="SpaceBetween"
        fitContainer="true"
        renderType="Bare">

        <!-- Donut Chart Card -->
        <f:Card
            width="49%"
            class="sapUiSmallMarginBeginEnd sapUiTinyMarginBottom">
           <f:header>
    <card:Header
        title="Employee Wise Expense Distribution"
       >

        <card:toolbar>
            <OverflowToolbar>

                <ToolbarSpacer/>

                <Button
                class="expBTN"
                    text="{i18n>Table}"
                    type="Transparent"
                    press="ED_onClickEmpExp"/>

            </OverflowToolbar>
        </card:toolbar>

    </card:Header>
</f:header>

            <f:content>
                <viz:VizFrame id="employeeDonutChart" vizType="donut" width="100%" height="350px" uiConfig="{applicationSet:'fiori'}" selectData="ED_onShowEmployeeExp"> 
                <viz:dataset> 
                <vizData:FlattenedDataset data="{DashboardModel>/EmployeeExpenses}" > <vizData:dimensions> 
                <vizData:DimensionDefinition name="Employee" value="{DashboardModel>EmployeeName}" /> 
                </vizData:dimensions> 
                <vizData:measures>
                 <vizData:MeasureDefinition name="Expense Amount" value="{DashboardModel>TotalAmount}" /> 
                
                </vizData:measures> 
                </vizData:FlattenedDataset> 
                </viz:dataset> 
                </viz:VizFrame>
            </f:content>

        </f:Card>

        <!-- Line Chart Card -->
        <f:Card
            width="49%"
            class="sapUiSmallMarginEnd sapUiTinyMarginBottom"
            >
           <f:header>
    <card:Header
        title="Employee Wise Expense Distribution"
       >

        <card:toolbar>
            <OverflowToolbar>

                <ToolbarSpacer/>

                <Button
                class="expBTN"
                    text="{i18n>Table}"
                    type="Transparent"
                    press="ED_onClickEmpExp"/>

            </OverflowToolbar>
        </card:toolbar>

    </card:Header>
</f:header>

            <f:content>
                <viz:VizFrame
                    id="employeeLineChart"
                    vizType="line"
                    width="100%"
                    height="350px"
                    selectData="ED_onShowEmployeeExp"
                    uiConfig="{applicationSet:'fiori'}">

                    <viz:dataset>
                        <vizData:FlattenedDataset data="{DashboardModel>/EmployeeExpenses}">
                            <vizData:dimensions>
                                <vizData:DimensionDefinition
                                    name="Employee"
                                    value="{DashboardModel>EmployeeName}" />
                            </vizData:dimensions>

                            <vizData:measures>
                                <vizData:MeasureDefinition
                                    name="Expense Amount"
                                    value="{DashboardModel>TotalAmount}" />
                            </vizData:measures>
                        </vizData:FlattenedDataset>
                    </viz:dataset>

                </viz:VizFrame>
            </f:content>

        </f:Card>

    </HBox>

</VBox>


</content>
<footer>
			<Bar>
			<contentLeft>
                    <core:Fragment
                        fragmentName="sap.kt.com.minihrsolution.fragment.Footer"
                        type="XML"
                    />
                </contentLeft>
					   
				
			</Bar>
		</footer>
</Page>
</mvc:View>