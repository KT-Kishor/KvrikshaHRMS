{
  "name": "mini-hr-solution",
  "version": "0.0.1",
  "description": "An SAP Fiori application.",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "devDependencies": {
    "@sap/ux-ui5-tooling": "1",
    "@ui5/cli": "^3.11.6"
  },
  "scripts": {
    "start-offline": "node init && ui5 serve -o index.html",
    "start": "node init && fiori run --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#sapktcomminihrsolution-display\"",
    "start-local": "node init && fiori run --config ./ui5-local.yaml --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#sapktcomminihrsolution-display\"",
    "build": "node init && ui5 build --config=ui5.yaml --clean-dest --dest dist",
    "deploy": "fiori verify",
    "deploy-config": "fiori add deploy-config",
    "start-noflp": "node init && fiori run --open \"index.html?sap-ui-xx-viewCache=false\"",
    "start-variants-management": "node init && fiori run --open \"preview.html?sap-ui-xx-viewCache=false&fiori-tools-rta-mode=true&sap-ui-rta-skip-flex-validation=true#preview-app\"",
    "unit-tests": "fiori run --open 'test/unit/unitTests.qunit.html'",
    "int-tests": "fiori run --open 'test/integration/opaTests.qunit.html'"
  },
  "sapuxLayer": "CUSTOMER_BASE",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "lodash": "^4.17.21"
  }
}
